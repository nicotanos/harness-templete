#!/usr/bin/env bash
# pre-commit hook — validates KB files before commit
# Only runs if files within docs/ were modified

set -euo pipefail

# Check if docs/ files are staged
STAGED_KB_FILES=$(git diff --cached --name-only | grep '^docs/' || true)

if [[ -z "$STAGED_KB_FILES" ]]; then
  exit 0
fi

echo "KB files staged, running validation..."
if ! python3 scripts/kb_validate.py docs/ --quiet; then
  echo "ERROR: KB validation failed - see messages above" >&2
  exit 1
fi
